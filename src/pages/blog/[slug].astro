---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} — Automation For Local`} description={post.data.description}>
	<article class="max-w-3xl mx-auto px-6 py-16">
		<h1 class="text-3xl font-bold">{post.data.title}</h1>
		<time class="mt-3 block text-sm text-white/40">
			{post.data.pubDate.toLocaleDateString('en-US', {
				year: 'numeric',
				month: 'long',
				day: 'numeric',
			})}
		</time>
		{
			post.data.affiliateDisclosure && (
				<p class="mt-4 text-sm text-white/50 italic">
					This post may contain affiliate links. We may earn a commission at no extra cost to
					you.
				</p>
			)
		}
		<div class="prose prose-invert mt-10 max-w-none">
			<Content />
		</div>
	</article>
</BaseLayout>
<style>
        .prose a {
                font-weight: 700;
                color: #00d4ff;
                text-decoration: underline;
        }

        .prose p {
                margin-bottom: 1.5rem;
        }
</style>