---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Blog — Automation For Local">
	<section class="max-w-3xl mx-auto px-6 py-16">
		<h1 class="text-3xl font-bold mb-10">Blog</h1>

		{
			posts.length === 0 ? (
				<p class="text-white/60">No posts yet. Check back soon.</p>
			) : (
				<ul class="space-y-8">
					{posts.map((post) => (
						<li class="border-b border-white/10 pb-8">
							<a href={`/blog/${post.id}`} class="block group">
								<h2 class="text-xl font-semibold group-hover:text-cyan transition-colors">
									{post.data.title}
								</h2>
								<p class="mt-2 text-white/60">{post.data.description}</p>
								<time class="mt-3 block text-sm text-white/40">
									{post.data.pubDate.toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'long',
										day: 'numeric',
									})}
								</time>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</section>
</BaseLayout>
